# =====================================================
# 更容易Eee (ShiftE+) — 環境變數範例
# 複製此檔為 .env 並填入實際值（切勿 commit 真實 .env）
# =====================================================

# 伺服器
PORT=3000

# 對外網址（用於 Stripe success_url / cancel_url 等回傳）
# 你已購買的網域：https://shifteee.com（上線後請用 HTTPS）
PUBLIC_BASE_URL=https://shifteee.com

# SQLite 資料庫（開發環境）
DATABASE_URL=sqlite:./database.sqlite

# 付款方式（若未設定，該付款選項會被停用）
DEFAULT_PAYMENT_METHOD=mock

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AlipayHK / PayMe 付款連結
ALIPAYHK_PAYMENT_URL=
PAYME_PAYMENT_URL=

# 管理員保護（設定後，呼叫 /api/companies/:id/mark-paid 需帶 header: x-admin-token）
ADMIN_TOKEN=

# WhatsApp Cloud API（官方遷移用，第 0-1 步）
# MESSAGING_PROVIDER=whatsapp-web   # 預設；遷移後改 cloud-api
MESSAGING_PROVIDER=
META_WHATSAPP_TOKEN=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v21.0